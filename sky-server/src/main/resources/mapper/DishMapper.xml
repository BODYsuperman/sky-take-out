<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishMapper">


    <!-- 条件查询菜品列表 -->
    <select id="list" resultType="com.sky.entity.Dish">
        SELECT * FROM dish
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>


    <!-- 分页查询菜品 -->
    <select id="pageQuery" resultType="com.sky.vo.DishVO">
        SELECT d.*, c.name AS categoryName
        FROM dish d
        LEFT JOIN category c ON d.category_id = c.id
        <where>
            <if test="name != null and name != ''">
                AND d.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="categoryId != null">
                AND d.category_id = #{categoryId}
            </if>
            <if test="status != null">
                AND d.status = #{status}
            </if>
        </where>
        ORDER BY d.create_time DESC
    </select>

    <!--    根据套餐id查询菜品-->
    <select id="getBySetmealId" resultType="com.sky.entity.Dish">
        select d.*
        from dish d,
        setmeal_dish sd
        where d.id = sd.dish_id
        and sd.setmeal_id = #{id}
    </select>

    <!--    获取菜品-->
    <select id="selectById" resultType="com.sky.entity.Dish">
        select *
        from dish where id=#{id};
    </select>




    <!--    修改菜品基本信息-->
    <update id="update">
        update dish
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="price != null">price = #{price},</if>
            <if test="image != null">image = #{image},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
        </set>
        where id =#{id}
    </update>


    <select id="deleteBatch">
       delete from dish where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>

    </select>

    <select id="getByDishId" resultType="com.sky.entity.Dish" parameterType="java.lang.Long">
        SELECT * FROM dish WHERE id = #{id}
    </select>

    <delete id="deleteById">

    </delete>
</mapper>